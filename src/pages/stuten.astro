---
import Layout from '../layouts/Layout.astro'
import { getCollection, getEntry, render } from 'astro:content'
import HorseCard from "../components/horses/HorseCard.astro";

let horses = await getCollection('horses')
horses = horses.sort((a, b) => (a.data.birth_year < b.data.birth_year) ? 1 : ((b.data.birth_year < a.data.birth_year) ? -1 : 0))
const mares = horses.filter(horse => horse.data.gender === 'Stute').filter(horse => horse.data.status === 'active' || horse.data.status === 'for-sale')

const stuten = await getEntry('pages', 'stuten')
const {Content} = await render(stuten)
---

<Layout title="Stuten">
    <div class="page-width mx-auto px-4 space-y-24">
        <div class="space-y-4 text-2xl">
            <h1>Stuten</h1>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
              {mares.map(horse => (
                      <HorseCard horse={horse} showForSaleLabel/>
              ))}
            </div>
        </div>

        <div class="prose">
            <Content/>
        </div>
    </div>
</Layout>

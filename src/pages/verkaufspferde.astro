---
import Layout from "../layouts/Layout.astro"
import { getCollection, getEntry, render } from "astro:content"
import HorseCard from "../components/horses/HorseCard.astro"

let horses = await getCollection("horses")
horses = horses.sort((a, b) => (a.data.birth_year < b.data.birth_year ? 1 : b.data.birth_year < a.data.birth_year ? -1 : 0))
const horsesForSale = horses.filter((horse) => horse.data.status === "for-sale")

const verkaufspferde = await getEntry("pages", "verkaufspferde")
if (!verkaufspferde) throw new Error("Verkaufspferde page not found")
const { Content } = await render(verkaufspferde)
---

<Layout title="Verkaufspferde">
  <div class="page-width mx-auto space-y-24 px-4">
    <div class="space-y-4 text-2xl">
      <h1>Verkaufspferde</h1>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {horsesForSale.map((horse) => <HorseCard horse={horse} showForSaleLabel />)}
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>
  </div>
</Layout>

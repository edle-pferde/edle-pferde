---
import Layout from "../layouts/Layout.astro"
import { getEntry, render } from "astro:content"
import PhotoSwipeAll from "../components/PhotoSwipeAll.astro"

const aboutUs = await getEntry("pages", "about-us")
if (!aboutUs) throw new Error("Über-uns page not found")
const { Content } = await render(aboutUs)
---

<Layout title="Über uns">
  <div class="page-width mx-auto px-4 md:px-0">
    <div class="prose">
      <h1>{aboutUs.data.title}</h1>
      <Content />
      <PhotoSwipeAll images={aboutUs.data.gallery} />
    </div>
  </div>
</Layout>

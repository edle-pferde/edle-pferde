---
import Layout from "../layouts/Layout.astro";
import {getEntry, render} from 'astro:content'
import PhotoSwipeAll from "../components/PhotoSwipeAll.astro";

const aboutUs = await getEntry('pages', 'about-us')
const {Content} = await render(aboutUs)
---
<Layout
  title="Über uns"
  description="Seit 2006 züchten wir im Hausruckviertel Trakehner mit bester Rittigkeit, Interieur und Exterieur: familiär, individuell und mit viel Herz."
>
    <main class="page-width mx-auto px-4 md:px-0">
        <div class="prose">
            <h1>{aboutUs.data.title}</h1>
            <Content/>
            <PhotoSwipeAll images={aboutUs.data.gallery} altText="Trakehner Gestüt Pichl" />
        </div>
    </main>
</Layout>

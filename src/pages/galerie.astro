---
import Layout from "../layouts/Layout.astro";
import {getEntry} from 'astro:content'
import PhotoSwipeAll from "../components/PhotoSwipeAll.astro";

const page = await getEntry('pages', 'galerie')
---
<Layout
  title="Fotos vom Trakehner Gestüt Pichl"
  description="Impressionen vom Trakehner Gestüt Pichl: Fotos unserer Stuten, Fohlen und Sportpferde auf der Koppel, im Stall und auf dem Turnier."
>
  <main class="page-width mx-auto px-4 md:px-0">
    <PhotoSwipeAll images={page.data.gallery} />
  </main>
</Layout>

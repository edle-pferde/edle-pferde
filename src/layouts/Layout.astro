---
import SpeedInsights from "@vercel/speed-insights/astro"
import "../styles/global.css"
import Menu from "../components/Menu.astro"
import Footer from "../components/Footer.astro"

export interface Props {
  title: string
  image?: string
}

const { title, image } = Astro.props
const site = Astro.site ?? new URL("https://edle-pferde.com")
const ogImage = new URL(image || "/hero.webp", site).href
const pageUrl = Astro.url
---

<!doctype html>
<html lang="de">
  <head>
    <title>{title}</title>
    <meta name="description" content="4716 Hofkirchen an der Trattnach, Oberösterreich" />
    <meta
      name="keywords"
      content="Trakehner, Pferdezucht, Gestüt, Trakehner Gestüt, Pichl, Oberösterreich, Pramendorfer, Pferde, Verkaufspferde, Sportpferde, Reitpferde"
    />
    <meta name="author" content="Familie Pramendorfer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content="4716 Hofkirchen an der Trattnach, Oberösterreich" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_AT" />
    <meta property="og:site_name" content="Trakehner Gestüt Pichl" />
    <meta property="og:logo" content="https://edle-pferde.com/logo.svg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="4716 Hofkirchen an der Trattnach, Oberösterreich" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon_dark.ico" type="image/x-icon" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-primary-50">
    <Menu />
    <main>
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
  </body>
</html>

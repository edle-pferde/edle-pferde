---
import SpeedInsights from "@vercel/speed-insights/astro"
import "../styles/global.css";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[];
}

const SITE_NAME = "Trakehner Gestüt Pichl";
const DEFAULT_DESCRIPTION = "Familiäre Trakehnerzucht im Hausruckviertel, Oberösterreich: Verkaufspferde direkt vom Züchter, Zuchtstuten, Nachzucht und Turniererfolge.";

const { title, description = DEFAULT_DESCRIPTION, image = "/hero.webp", schema = [] } = Astro.props;
const schemas = Array.isArray(schema) ? schema : [schema];

const imageUrl = new URL(image, Astro.site).href;
const isNotFound = Astro.url.pathname.startsWith("/404");
const canonicalUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), Astro.site).href;
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Familie Pramendorfer">
    <meta name="viewport" content="width=device-width" />
    {!isNotFound && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={imageUrl}>
    {!isNotFound && <meta property="og:url" content={canonicalUrl}>}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="de_AT">
    <meta property="og:site_name" content={SITE_NAME}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageUrl}>
    {schemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
    ))}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" href="/favicon_dark.ico" type="image/x-icon" media="(prefers-color-scheme: dark)">
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-primary-50">
    <Menu />
    <main>
      <slot />
    </main>
    <Footer />
    <SpeedInsights/>
  </body>
</html>
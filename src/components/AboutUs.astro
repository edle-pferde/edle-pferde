---
import Image from 'astro/components/Image.astro'
import farm from '../assets/Gestuet1_0.jpg'
import mareWithFoal from '../assets/LQKL0944_0.jpg'
---
<div class="page-width mx-auto px-4 md:px-0">
  <div class="flex lg:flex-row flex-col items-center">
    <div class="flex -space-x-48 md:-space-x-40 md:mx-20 mb-16">
      <div>
        <Image
          class="size-[300px] object-cover rounded-xl shadow-2xl -rotate-6"
          widths={[300, 600]}
          sizes="300px"
          alt="Hof des Trakehner Gestüts Pichl mit großer Linde"
          src={farm}
          loading="lazy"
        />
      </div>
      <div class="pt-48">
        <Image
          class="size-[300px] object-cover rounded-xl shadow-2xl rotate-6"
          widths={[300, 600]}
          sizes="300px"
          alt="Stute mit Fohlen auf der Koppel"
          src={mareWithFoal}
          loading="lazy"
        />
      </div>
    </div>
    <div class="space-y-8 flex-1 px-8 lg:px-0">
      <div class="space-y-2">
        <h2 class="text-brand font-semibold text-2xl!">Über uns</h2>
        <div class="text-brand">Eine 30-jährige Geschichte</div>
      </div>
      <div class="bg-primary-600 w-20 h-1"></div>
      <p class="font-normal text-brand text-sm lg:text-balance">
        Herzlich willkommen am Trakehner Gestüt Pichl in
        Oberösterreich! Unser Hof liegt im Herzen des
        Hausruckviertels, 30 Kilometer von der Grenze zu Bayern
        entfernt. Seit 2006 bestreben wir mit unserer kleinen, aber
        feinen Trakehnerzucht, perfekte Partner für Sport und Freizeit
        zu züchten.
      </p>
      <a href="/ueber-uns">
      <div class="w-fit px-8 py-4 bg-brand rounded-full font-semibold text-white text-sm">
        MEHR ERFAHREN
      </div>
      </a>
    </div>
  </div>
</div>

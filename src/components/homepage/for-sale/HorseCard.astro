---
import { IconColorPicker, IconHorseshoe, IconRuler, IconCalendar } from "@tabler/icons-react"
import Image from "astro/components/Image.astro"
const { horse } = Astro.props
---

<div class="flex overflow-hidden rounded-2xl bg-white shadow-2xl">
  <div class="relative flex flex-1 grow flex-col items-start justify-between self-stretch">
    <div class="flex flex-1 flex-col justify-between px-16 py-12">
      <div class="text-brand text-3xl text-balance">
        {horse.data.full_name}
      </div>
      <div class="flex flex-col space-y-8">
        <div class="flex items-center space-x-4">
          <IconCalendar className="text-brand" />
          <div class="relative flex-1 text-base leading-4 font-normal tracking-normal text-[#1e1e1e]">
            {horse.data.birth_year}
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <IconHorseshoe className="text-brand" />
          <div class="relative flex-1 text-base leading-4 font-normal tracking-normal text-[#1e1e1e]">
            {horse.data.breed}
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <IconRuler className="text-brand" />
          <div class="relative flex-1 text-base leading-4 font-normal tracking-normal text-[#1e1e1e]">
            {horse.data.size}
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <IconColorPicker className="text-brand" />
          <div class="relative flex-1 text-base leading-4 font-normal tracking-normal text-[#1e1e1e]">
            {horse.data.color}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="relative flex flex-1 flex-col">
    <Image class="aspect-4/3 object-cover" src={horse.data.profile_picture} alt={`${horse.id}`} width={960} loading="eager" />
    <div class="absolute inset-0 bg-linear-to-r from-white to-25%"></div>
  </div>
</div>

---
import Image from "astro/components/Image.astro"
const { article } = Astro.props
---

<a href={`/news/${article.id}`} class="col-span-4 md:row-span-4">
  <div class="relative aspect-3/2 lg:aspect-2/1">
    <Image
      src={article.data.cover_image}
      alt={article.data.title}
      height={0}
      width={0}
      loading="eager"
      class="z-10 h-full w-full rounded-lg object-cover"
      transition:name={`article-${article.id}`}
    />
    <div class="absolute inset-0 z-10 rounded-b-lg bg-linear-to-t from-black via-transparent"></div>
    <div class="absolute inset-x-4 bottom-4 z-10 space-y-1">
      <div class="line-clamp-2 text-xl font-semibold text-white md:text-3xl">
        {article.data.title}
      </div>
      <p class="hidden text-sm text-white/75 md:line-clamp-2">{stripMarkdown(article.body)}</p>
    </div>
  </div>
</a>

---
import Image from "astro/components/Image.astro"
const { article } = Astro.props

const cropPosition = cropPositionClass(article.data.cover_image_crop_position)
---

<a href={`/news/${article.id}`} class="col-span-4 md:col-span-2 md:row-span-2 lg:col-span-1">
  <div class="relative aspect-3/2 w-full md:h-full">
    <Image
      src={article.data.cover_image}
      alt={article.data.title}
      height={0}
      width={0}
      loading="eager"
      class={`object-cover z-10 rounded-lg w-full h-full ${cropPosition}`}
      transition:name={`article-${article.id}`}
    />
    <div class="absolute inset-0 z-20 rounded-b-lg bg-linear-to-t from-black to-50%"></div>
    <div class="absolute inset-x-4 bottom-4 z-20 text-white">
      <div class="line-clamp-3 text-xl font-semibold md:text-base md:text-balance">
        {article.data.title}
      </div>
    </div>
  </div>
</a>

---
import Image from "astro/components/Image.astro"
import { getEntry } from "astro:content"

const { horseSlug } = Astro.props
const horse = await getEntry("horses", horseSlug)
if (!horse) throw new Error(`Horse not found: ${horseSlug}`)

const cropPosition = cropPositionClass(horse.data.profile_picture_crop_position)
---

<a href={`/pferde/${horse.id}`} class="box">
  <div class="flex flex-col overflow-auto rounded bg-white shadow">
    <Image
      src={horse.data.profile_picture}
      alt={horse.data.profile_picture_alt_text || horse.data.full_name}
      width={500}
      height={500}
      loading="eager"
      class={`object-cover aspect-square size-full ${cropPosition}`}
    />
    <div class="space-y-1 p-6">
      <div class="line-clamp-1 text-xl font-semibold">
        {horse.data.full_name}
      </div>
    </div>
  </div>
</a>

---
import { IconMail, IconPhone } from "@tabler/icons-react"
const { address, email_address, phone_number } = (await reader.singletons.contact.read()) ?? { address: "", email_address: "", phone_number: "" }
---

<footer class="border-primary-500 mt-16 space-y-16 border-t bg-white py-16">
  <div
    class="page-width mx-auto flex flex-col items-center justify-evenly space-y-8 px-4 text-center md:px-0 lg:flex-row lg:items-end lg:space-y-0 lg:text-left"
  >
    <div class="flex-1 space-y-4">
      <div class="font-semibold">Familie Pramendorfer</div>
      <div class="whitespace-pre-line">{address}</div>
    </div>
    <div class="flex-1">
      <div>
        <div class="flex items-center space-x-2">
          <IconMail className="text-primary-800" />
          <div class="">{email_address}</div>
        </div>
        <div class="flex items-center space-x-2">
          <IconPhone className="text-primary-800" />
          <div class="">{phone_number}</div>
        </div>
      </div>
    </div>
    <div class="flex-1">
      <div>
        <a href="/ueber-uns" class="hover:underline">Über uns</a>
      </div>
      <div>
        <a href="/impressum" class="hover:underline">Impressum</a>
      </div>
    </div>
  </div>
  <div class="text-center text-sm text-nowrap">© 2025 Edle Pferde</div>
</footer>

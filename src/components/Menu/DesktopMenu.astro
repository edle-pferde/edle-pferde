---
import { IconChevronDown } from "@tabler/icons-react"
const { facebook, instagram, youtube } = (await reader.singletons.social_media.read()) ?? { facebook: "", instagram: "", youtube: "" }
import Instagram from "./../socials/instagram.astro"
import Facebook from "./../socials/facebook.astro"
import YouTube from "./../socials/youtube.astro"
import Logo from "../Logo.astro"
---

<div
  class="page-width text-sm xl:text-base z-10 mx-auto mb-16 hidden h-20 grid-cols-8 grid-rows-1 items-center justify-evenly divide-x divide-gray-200 border-x border-gray-200 px-8 md:px-0 lg:grid"
>
  <a href="/" class="hover:bg-brand font-electrolize flex size-full items-center justify-center transition hover:text-white">
    <div class="uppercase">Home</div>
  </a>
  <a href="/news" class="hover:bg-brand font-electrolize flex size-full items-center justify-center transition hover:text-white">
    <div class="uppercase">News</div>
  </a>
  <div class="group dropdown relative size-full">
    <button
      class="hover:bg-brand font-electrolize flex size-full items-center justify-center space-x-2 text-center text-nowrap uppercase transition hover:text-white"
    >
      <span>Pferde</span>
      <IconChevronDown />
    </button>
    <div class="dropdown-content absolute z-60 hidden min-w-48 bg-white shadow-lg group-focus-within:block group-hover:block divide-y divide-gray-200 border border-gray-200">
      <a href="/pferde" class="hover:bg-brand block p-4 hover:text-white">Alle Pferde</a>
      <a href="/verkaufspferde" class="hover:bg-brand block p-4 hover:text-white">Verkaufspferde</a>
      <a href="/stuten" class="hover:bg-brand block p-4 hover:text-white">Stuten</a>
    </div>
  </div>
  <a href="/" class="z-50 col-span-2 size-full px-4" title="Logo">
    <div class="max-w-32 xl:max-w-48 mx-auto mt-2">
      <Logo />
    </div>
  </a>
  <a href="/ueber-uns" class="hover:bg-brand font-electrolize flex size-full items-center justify-center transition hover:text-white">
    <div class="uppercase">Über uns</div>
  </a>
  <a href="/galerie" class="hover:bg-brand font-electrolize flex size-full items-center justify-center transition hover:text-white">
    <div class="uppercase">Galerie</div>
  </a>
  <div class="flex space-x-2 justify-center items-center size-full">
    <a href={"https://facebook.com/" + facebook} target="_blank">
      <span class="sr-only">Facebook</span>
      <Facebook />
    </a>
    <a href={"https://instagram.com/" + instagram} target="_blank">
      <span class="sr-only">Instagram</span>
      <Instagram />
    </a>
    <a href={"https://youtube.com/@" + youtube} target="_blank">
      <span class="sr-only">YouTube</span>
      <YouTube />
    </a>
  </div>
</div>

<style>
  .dropdown:hover .dropdown-content {
    display: block;
  }
</style>

---
import { IconChevronDown } from "@tabler/icons-react"
const { facebook, instagram, youtube } = (await reader.singletons.social_media.read()) ?? { facebook: "", instagram: "", youtube: "" }
import Instagram from "./../socials/instagram.astro"
import Facebook from "./../socials/facebook.astro"
import YouTube from "./../socials/youtube.astro"
import Logo from "../Logo.astro"
---

<div class="z-10 mx-auto mb-16 hidden h-20 w-5xl items-center justify-evenly lg:flex">
  <div class="flex-1"></div>
  <a href="/" class="hover:bg-brand font-electrolize flex-1 p-7 text-center text-nowrap uppercase transition hover:text-white">Home</a>
  <a href="/news" class="hover:bg-brand font-electrolize flex-1 p-7 text-center text-nowrap uppercase transition hover:text-white">News</a>
  <div class="group dropdown relative">
    <button class="hover:bg-brand font-electrolize flex flex-1 items-center space-x-2 p-7 text-center text-nowrap uppercase transition hover:text-white">
      <span>Pferde</span>
      <IconChevronDown />
    </button>
    <div class="dropdown-content absolute z-60 hidden min-w-48 bg-white shadow-lg group-focus-within:block group-hover:block">
      <a href="/pferde" class="hover:bg-brand block p-4 hover:text-white">Alle Pferde</a>
      <a href="/verkaufspferde" class="hover:bg-brand block p-4 hover:text-white">Verkaufspferde</a>
      <a href="/stuten" class="hover:bg-brand block p-4 hover:text-white">Stuten</a>
    </div>
  </div>
  <a href="/" class="z-50 mt-16 w-50 px-4" title="Logo">
    <Logo />
  </a>
  <a href="/ueber-uns" class="hover:bg-brand font-electrolize flex-1 p-7 text-center text-nowrap uppercase transition hover:text-white">Über uns</a>
  <a href="/galerie" class="hover:bg-brand font-electrolize flex-1 p-7 text-center text-nowrap uppercase transition hover:text-white">Galerie</a>
  <div class="flex-1"></div>
  <div class="flex flex-1 space-x-2 p-7 text-center">
    <a href={"https://facebook.com/" + facebook} target="_blank">
      <span class="sr-only">Facebook</span>
      <Facebook />
    </a>
    <a href={"https://instagram.com/" + instagram} target="_blank">
      <span class="sr-only">Instagram</span>
      <Instagram />
    </a>
    <a href={"https://youtube.com/@" + youtube} target="_blank">
      <span class="sr-only">YouTube</span>
      <YouTube />
    </a>
  </div>
</div>

<style>
  .dropdown:hover .dropdown-content {
    display: block;
  }
</style>

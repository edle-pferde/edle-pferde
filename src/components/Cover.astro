---
import Image from "astro/components/Image.astro"
import { IconHorse, IconUserHeart, IconMedal, IconMapPin } from "@tabler/icons-react"
---

<div class="-mt-16 flex flex-col">
  <Image
    src="/hero.webp"
    alt="Stute mit Fohlen"
    width={2056}
    height={800}
    quality={75}
    loading="eager"
    class="mx-auto h-[50vh] object-cover md:h-[80vh] 2xl:h-200"
  />
  <div class="px-4">
    <div class="page-width mx-auto -mt-20 grid grid-cols-2 items-center gap-px overflow-auto rounded-2xl bg-gray-200 shadow-2xl md:grid-cols-4">
      <div class="flex h-full flex-col items-center justify-center space-y-3 bg-white p-8">
        <IconHorse className="text-primary-800 size-10" />
        <div class="text-brand relative w-fit text-center text-base font-normal text-balance">Familiäre Pferdezucht</div>
      </div>
      <div class="flex h-full flex-col items-center justify-center space-y-3 bg-white p-8">
        <IconUserHeart className="text-primary-800 size-10" />
        <div class="text-brand relative w-fit text-center text-base font-normal text-balance">30 Jahre Erfahrung</div>
      </div>
      <div class="flex h-full flex-col items-center justify-center space-y-3 bg-white p-8">
        <IconMedal className="fill-primary-800 stroke-primary-800 size-10" />
        <div class="text-brand relative w-fit text-center text-base font-normal text-balance">Individuelle Ausbildung</div>
      </div>
      <div class="flex h-full flex-col items-center justify-center space-y-3 bg-white p-8">
        <IconMapPin className="text-primary-800 size-10" />
        <div class="text-brand relative w-fit text-center text-base font-normal text-balance">Im Herzen des Hausruckviertels</div>
      </div>
    </div>
  </div>
</div>
